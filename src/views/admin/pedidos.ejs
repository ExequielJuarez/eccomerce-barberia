<%- include('../partials/head') %>
<%- include('../partials/admin-inicio') %>
<%
  const precio = (n) => formatoPrecio(n).replace(',00', '');
  const nombres = { pendiente: 'Pendientes', vendido: 'Vendidos', cancelado: 'Cancelados' };
  const pestañas = [['', 'Todos', total]].concat(estados.map((e) => [e, nombres[e], conteo[e]]));
%>
<div class="adm-cab"><div><p class="etiqueta-seccion">Ventas</p><h1 class="adm-titulo titulo">Pedidos</h1></div></div>

<form method="GET" class="adm-filtros">
  <input type="hidden" name="estado" value="<%= filtros.estado %>">
  <label class="adm-buscar"><span class="sr-only">Buscar</span><input type="search" name="q" value="<%= filtros.q %>" placeholder="Buscar por número o cliente…"></label>
</form>
<div class="adm-rango" role="tablist" aria-label="Estado">
  <% pestañas.forEach(([k, n, c]) => { %><a href="/admin/pedidos?estado=<%= k %><%= filtros.q ? '&q=' + encodeURIComponent(filtros.q) : '' %>" class="filtro-chip <%= filtros.estado === k ? 'activo' : '' %>"><%= n %> <small><%= c %></small></a><% }) %>
</div>

<% if (!lista.length) { %><div class="panel"><p class="apagado vacio-panel">No hay pedidos con esos filtros.</p></div><% } %>
<div class="pedidos-lista" id="pedidosLista">
  <% lista.forEach((p) => { const s = situacionPedido(p); %>
    <article class="pedido panel" data-numero="<%= p.numero %>">
      <header class="pedido__cab">
        <div class="pedido__id"><strong class="titulo">#<%= p.numero %></strong><small><%= formatoFecha(p.fecha, true) %></small></div>
        <div class="pedido__cliente"><strong><%= p.cliente %></strong><small>WhatsApp <%= p.telefono %></small></div>
        <span class="estado estado--<%= s.clave %>" data-situacion><%= s.texto %></span>
        <strong class="precio"><%= precio(p.total) %></strong>
        <div class="pedido__acciones">
        <% if (linkWhatsapp(p)) { %><a class="btn btn--whatsapp btn--chico" href="<%= linkWhatsapp(p) %>" target="_blank" rel="noopener">Escribirle por WhatsApp</a><% } %>
        <button type="button" class="enlace" data-abrir aria-expanded="false">Detalle</button>
        </div>
      </header>
      <div class="pedido__cuerpo" hidden>
        <ul class="pedido__items">
          <% p.items.forEach((i) => { %><li><span><%= i.cantidad %> ×</span> <strong><%= i.nombre %></strong> <small><%= [i.color || ''].filter(Boolean).join(' · ') %></small><span class="num"><%= precio(i.precio * i.cantidad) %></span></li><% }) %>
        </ul>
        <div class="pedido__info">
          <div><span class="campo__label">Entrega</span><p><%= p.entrega === 'retiro' ? 'Retira en el local' : 'Envío a domicilio (se arregla por WhatsApp)' %></p></div>
          <div><span class="campo__label">Importes</span><p>Subtotal <%= precio(p.subtotal) %><% if (p.descuento > 0) { %> · Desc. −<%= precio(p.descuento) %><% } %> · Total <%= precio(p.total) %></p><p class="apagado">Ganancia <span data-ganancia><%= precio(p.ganancia) %></span></p></div>
        </div>
        <footer class="pedido__pie">
          <div class="pedido__estado" role="group" aria-label="Estado del pedido #<%= p.numero %>">
            <% if (p.estado !== 'vendido') { %><button type="button" class="btn btn--volt btn--chico" data-marcar="vendido">✓ Marcar vendido</button><% } %>
            <% if (p.estado !== 'cancelado') { %><button type="button" class="btn btn--linea btn--chico" data-marcar="cancelado">Cancelar pedido</button><% } %>
            <% if (p.estado !== 'pendiente') { %><button type="button" class="btn btn--linea btn--chico" data-marcar="pendiente">Volver a pendiente</button><% } %>
          </div>
          <a class="btn btn--linea btn--chico" href="/admin/pedidos/<%= p.numero %>/comprobante" target="_blank" rel="noopener">Comprobante</a>
        </footer>
      </div>
    </article>
  <% }) %>
</div>
<%- include('../partials/admin-fin') %>
<script src="/js/admin-pedidos.js"></script>
</body>
</html>

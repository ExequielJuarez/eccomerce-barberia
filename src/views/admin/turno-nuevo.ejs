<%- include('../partials/head') %>
<%- include('../partials/admin-inicio') %>
<%
  const precio = (n) => formatoPrecio(n).replace(',00', '');
%>
<div class="adm-cab">
  <div>
    <p class="etiqueta-seccion"><%= perfil.sucursal %></p>
    <h1 class="adm-titulo titulo">Agregar turno</h1>
  </div>
  <div class="agenda-acciones">
    <a href="/barbero" class="btn btn--linea btn--chico">← Volver a mis turnos</a>
  </div>
</div>

<section class="panel">
  <header class="panel__cab"><h2>Cliente que llegó al local</h2><span class="apagado">El turno queda confirmado y a tu nombre. Se guarda en la agenda igual que los reservados online.</span></header>
  <form action="/barbero/turnos" method="POST" class="equipo-form" id="formNuevoTurno">
    <div class="campo">
      <label for="nt-servicio">Servicio</label>
      <select id="nt-servicio" name="servicio" required>
        <option value="">Elegí un servicio</option>
        <% servicios.forEach((s) => { %><option value="<%= s.id %>"><%= s.nombre %> · <%= s.duracion %> min<%= s.precio !== null ? ' · ' + precio(s.precio) : '' %></option><% }) %>
      </select>
    </div>
    <div class="campo">
      <label for="nt-fecha">Día</label>
      <select id="nt-fecha" name="fecha" required>
        <% dias.forEach((d) => { %><option value="<%= d.fecha %>" <%= d.hoy ? 'selected' : '' %>><%= d.hoy ? 'Hoy' : d.semana %> <%= d.dia %> de <%= d.mes %></option><% }) %>
      </select>
    </div>
    <div class="campo">
      <label for="nt-hora">Horario</label>
      <select id="nt-hora" name="hora" required disabled><option value="">Elegí servicio y día</option></select>
    </div>
    <div class="campo"><label for="nt-cliente">Nombre del cliente</label><input id="nt-cliente" name="cliente" maxlength="90" autocomplete="off" required></div>
    <div class="campo"><label for="nt-telefono">Teléfono (opcional)</label><input id="nt-telefono" name="telefono" type="tel" inputmode="tel" maxlength="25" placeholder="385 555 1234"></div>
    <div class="campo"><label for="nt-notas">Aclaraciones (opcional)</label><input id="nt-notas" name="notas" maxlength="200"></div>
    <p class="apagado completo" id="ntAyuda"></p>
    <div class="equipo-form__fin"><button class="btn btn--volt">Guardar turno</button></div>
  </form>
</section>

<%- include('../partials/admin-fin') %>
<script src="/js/admin-turno-nuevo.js"></script>
</body>
</html>

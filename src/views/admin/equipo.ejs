<%- include('../partials/head') %>
<%- include('../partials/admin-inicio') %>
<%
  const inicial = (n) => String(n).trim().charAt(0).toUpperCase();
%>
<div class="adm-cab">
  <div>
    <p class="etiqueta-seccion">Peluquerías</p>
    <h1 class="adm-titulo titulo">Equipo</h1>
  </div>
  <div class="agenda-acciones">
    <a href="/admin/turnos" class="btn btn--linea btn--chico">Ver agenda</a>
  </div>
</div>

<section class="panel" id="nuevo">
  <header class="panel__cab"><h2>Nuevo peluquero</h2><span class="apagado">Se crea su usuario: entra con su email y contraseña y ve solo sus turnos.</span></header>
  <form action="/admin/equipo" method="POST" enctype="multipart/form-data" class="equipo-form">
    <div class="campo"><label for="n-nombre">Nombre</label><input id="n-nombre" name="nombre" maxlength="40" required></div>
    <div class="campo"><label for="n-apellido">Apellido</label><input id="n-apellido" name="apellido" maxlength="40"></div>
    <div class="campo"><label for="n-email">Email (para iniciar sesión)</label><input id="n-email" name="email" type="email" maxlength="120" autocomplete="off" required></div>
    <div class="campo"><label for="n-password">Contraseña</label><input id="n-password" name="password" type="text" minlength="8" maxlength="72" autocomplete="new-password" placeholder="8+ caracteres, letras y números" required></div>
    <div class="campo"><label for="n-telefono">Teléfono</label><input id="n-telefono" name="telefono" type="tel" maxlength="20"></div>
    <div class="campo">
      <label for="n-sucursal">Sucursal</label>
      <select id="n-sucursal" name="sucursalId" required>
        <% sucursales.filter((s) => s.activo).forEach((s) => { %><option value="<%= s.id %>"><%= s.nombre %> · <%= s.direccion %></option><% }) %>
      </select>
    </div>
    <div class="campo completo"><label for="n-foto">Foto (JPG, PNG o WEBP, hasta 2 MB)</label><input id="n-foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp"></div>
    <div class="equipo-form__fin"><button class="btn btn--volt">Crear peluquero</button></div>
  </form>
</section>

<% sucursales.forEach((suc) => {
     const deLaSucursal = lista.filter((b) => b.sucursalId === suc.id); %>
<section class="panel">
  <header class="panel__cab"><h2><%= suc.nombre %></h2><span class="apagado"><%= suc.direccion %> · <%= deLaSucursal.length %> <%= deLaSucursal.length === 1 ? 'peluquero' : 'peluqueros' %></span></header>
  <% if (!deLaSucursal.length) { %><p class="apagado">Todavía no hay peluqueros en esta sucursal.</p><% } %>
  <ul class="equipo-lista">
    <% deLaSucursal.forEach((b) => { %>
      <li class="equipo-item <%= b.activo ? '' : 'equipo-item--apagado' %>">
        <div class="equipo-item__cab">
          <span class="equipo-item__foto"><% if (b.foto) { %><img src="<%= b.foto %>" alt=""><% } else { %><b><%= inicial(b.nombre) %></b><% } %></span>
          <div class="equipo-item__datos">
            <strong><%= b.nombre %></strong>
            <small class="apagado"><%= b.email || 'Sin usuario' %><%= b.telefono ? ' · ' + b.telefono : '' %></small>
            <span class="estado <%= b.activo ? 'estado--ok' : 'estado--cancelado' %>"><%= b.activo ? 'Atiende' : 'No recibe reservas' %></span>
          </div>
          <form action="/admin/equipo/<%= b.id %>?_method=DELETE" method="POST" data-confirmar="¿Eliminar a <%= b.nombre %>? También se borra su usuario.">
            <button class="btn btn--peligro btn--chico">Eliminar</button>
          </form>
        </div>
        <details class="equipo-item__editar">
          <summary class="btn btn--linea btn--chico">Editar</summary>
          <form action="/admin/equipo/<%= b.id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="equipo-form">
            <% const partes = b.nombre.split(' '); %>
            <div class="campo"><label for="e-nombre-<%= b.id %>">Nombre</label><input id="e-nombre-<%= b.id %>" name="nombre" value="<%= partes[0] %>" maxlength="40" required></div>
            <div class="campo"><label for="e-apellido-<%= b.id %>">Apellido</label><input id="e-apellido-<%= b.id %>" name="apellido" value="<%= partes.slice(1).join(' ') %>" maxlength="40"></div>
            <div class="campo"><label for="e-telefono-<%= b.id %>">Teléfono</label><input id="e-telefono-<%= b.id %>" name="telefono" type="tel" value="<%= b.telefono %>" maxlength="20"></div>
            <div class="campo">
              <label for="e-sucursal-<%= b.id %>">Sucursal</label>
              <select id="e-sucursal-<%= b.id %>" name="sucursalId">
                <% sucursales.forEach((s) => { %><option value="<%= s.id %>" <%= s.id === b.sucursalId ? 'selected' : '' %>><%= s.nombre %></option><% }) %>
              </select>
            </div>
            <div class="campo"><label for="e-password-<%= b.id %>">Nueva contraseña (opcional)</label><input id="e-password-<%= b.id %>" name="password" type="text" maxlength="72" autocomplete="new-password" placeholder="Dejala vacía para no cambiarla"></div>
            <div class="campo"><label for="e-foto-<%= b.id %>">Cambiar foto</label><input id="e-foto-<%= b.id %>" name="foto" type="file" accept="image/jpeg,image/png,image/webp"></div>
            <label class="tilde"><input type="checkbox" name="activo" value="1" <%= b.activo ? 'checked' : '' %>><span>Atiende (recibe reservas)</span></label>
            <div class="equipo-form__fin"><button class="btn btn--volt btn--chico">Guardar cambios</button></div>
          </form>
        </details>
      </li>
    <% }) %>
  </ul>
</section>
<% }) %>

<%- include('../partials/admin-fin') %>
</body>
</html>

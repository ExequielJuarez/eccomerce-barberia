<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const precio = (n) => formatoPrecio(n).replace(',00', '');
  const p = pedido;
  const s = situacionPedido(p);
  const pasos = pasosPedido(p);
  const primerNombre = String(p.cliente).split(' ')[0];
  const nuevo = p.medioPago === 'whatsapp' && p.estado === 'pendiente';
  let encabezado, bajada;
  if (nuevo) {
    encabezado = `¡Gracias, ${primerNombre}!`; bajada = 'Recibimos tu pedido. Nos estaremos poniendo en contacto con vos por WhatsApp para coordinar el pago y ' + (p.entrega === 'retiro' ? 'el retiro.' : 'el envío.');
  } else {
    encabezado = `Pedido #${p.numero}`; bajada = s.detalle;
  }
%>
<section class="contenedor pagina">
  <nav class="migas" aria-label="Ruta">
    <a href="/">Inicio</a><span>/</span>
    <span aria-current="page">Pedido #<%= p.numero %></span>
  </nav>

  <header class="pedido-cab">
    <p class="etiqueta-seccion">Pedido #<%= p.numero %> · <%= formatoFecha(p.fecha, true) %></p>
    <h1 class="pagina__titulo titulo"><%= encabezado %></h1>
    <p class="pagina__sub"><%= bajada %></p>
    <span class="estado estado--<%= s.clave %>"><%= s.texto %></span>
  </header>

  <% if (sePuedeCancelar || (nuevo && linkWhatsapp)) { %>
    <div class="pedido-acciones">
      <% if (nuevo && linkWhatsapp) { %><a href="<%= linkWhatsapp %>" target="_blank" rel="noopener" class="btn btn--volt">Escribinos por WhatsApp</a><% } %>
      <% if (sePuedeCancelar) { %>
        <form action="/pedido/<%= p.numero %>/cancelar" method="POST" data-confirmar="¿Cancelar este pedido?"><button class="btn btn--linea">Cancelar pedido</button></form>
      <% } %>
    </div>
  <% } %>

  <% if (p.estado !== 'cancelado') { %>
    <ol class="linea-tiempo" aria-label="Seguimiento">
      <% pasos.forEach((paso) => { %>
        <li class="<%= paso.hecho ? 'hecho' : '' %> <%= paso.actual ? 'actual' : '' %>">
          <span class="linea-tiempo__punto"></span>
          <strong><%= paso.texto %></strong>
          <small><%= paso.fecha && paso.hecho ? formatoFecha(paso.fecha, true) : '' %></small>
        </li>
      <% }) %>
    </ol>
  <% } %>

  <div class="detalle-grilla">
    <div class="detalle-col">
      <section class="caja">
        <h2 class="caja__titulo">Productos</h2>
        <ul class="mini-items mini-items--grande">
          <% p.items.forEach((i) => { %>
            <li>
              <span class="mini-items__foto"><% if (i.imagen) { %><img src="<%= i.imagen %>" alt=""><% } %><b><%= i.cantidad %></b></span>
              <span class="mini-items__datos"><strong><%= i.nombre %></strong><small><%= [i.color || ''].filter(Boolean).join(' · ') %></small></span>
              <span class="mini-items__precio"><%= precio(i.precio * i.cantidad) %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    </div>

    <aside class="detalle-col">
      <section class="caja">
        <h2 class="caja__titulo">Resumen</h2>
        <dl class="totales">
          <div><dt>Subtotal</dt><dd><%= precio(p.subtotal) %></dd></div>
          <% if (p.descuento > 0) { %><div><dt>Descuentos<%= p.cuponCodigo ? ' (' + p.cuponCodigo + ')' : '' %></dt><dd class="resaltado">−<%= precio(p.descuento) %></dd></div><% } %>
          <div><dt>Envío</dt><dd><%= p.envio > 0 ? precio(p.envio) : 'Gratis' %></dd></div>
          <div class="totales__total"><dt>Total</dt><dd class="precio"><%= precio(p.total) %></dd></div>
        </dl>
        <p class="apagado texto-chico"><%= {transferencia: 'Transferencia bancaria', tarjeta: 'Tarjeta · Mercado Pago'}[p.medioPago] || 'Pago a coordinar por WhatsApp' %><%= p.pagoDetalle ? ' — ' + p.pagoDetalle : '' %></p>
      </section>
      <section class="caja">
        <h2 class="caja__titulo"><%= p.entrega === 'retiro' ? 'Retiro en el local' : 'Envío a' %></h2>
        <% if (p.entrega === 'retiro') { %>
          <p><%= tienda.direccion %></p><% if (tienda.horarios) { %><p class="apagado"><%= tienda.horarios %></p><% } %>
        <% } else { %>
          <p><%= p.calle %> <%= p.altura %><%= p.piso ? ', ' + p.piso : '' %></p>
          <p class="apagado"><%= p.ciudad %>, <%= p.provincia %> (<%= p.codigoPostal %>)</p>
        <% } %>
        <p class="apagado separado-arriba"><%= p.cliente %> · <%= p.email %> · <%= p.telefono %></p>
      </section>
      <p class="aviso">Guardá el número <strong>#<%= p.numero %></strong> por si querés consultarnos por tu pedido.</p>
    </aside>
  </div>
</section>
<%- include('partials/footer') %>
<script src="/js/mi-pedido.js"></script>
</body>
</html>

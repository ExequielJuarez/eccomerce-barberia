<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const precio = (n) => formatoPrecio(n).replace(',00', '');
  const p = pedido;
  const primerNombre = String(p.cliente).split(' ')[0];
  const cancelado = p.estado === 'cancelado';
  const encabezado = cancelado ? `Pedido #${p.numero}` : `¡Gracias, ${primerNombre}!`;
  const bajada = cancelado ? 'Este pedido fue cancelado.' : 'Te estaremos contactando por WhatsApp en breve.';
%>
<section class="contenedor pagina">
  <nav class="migas" aria-label="Ruta">
    <a href="/">Inicio</a><span>/</span>
    <span aria-current="page">Pedido #<%= p.numero %></span>
  </nav>

  <header class="pedido-cab">
    <p class="etiqueta-seccion">Pedido #<%= p.numero %> · <%= formatoFecha(p.fecha, true) %></p>
    <h1 class="pagina__titulo titulo"><%= encabezado %></h1>
    <p class="pagina__sub"><%= bajada %></p>
  </header>

  <% if (!cancelado && linkWhatsapp) { %>
    <div class="pedido-acciones">
      <a href="<%= linkWhatsapp %>" target="_blank" rel="noopener" class="btn btn--whatsapp btn--grande" data-auto-wa>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 00-8.5 14.95L2 22l5.2-1.5A9.95 9.95 0 1012.04 2zm0 18.1c-1.5 0-2.97-.4-4.25-1.16l-.3-.18-3.08.9.92-3-.2-.31A8.1 8.1 0 1112.04 20.1zm4.4-6.05c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.1.16 1.52.1.46-.07 1.43-.58 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28z"/></svg>
        Enviar pedido por WhatsApp
      </a>
    </div>
  <% } %>

  <div class="detalle-grilla">
    <div class="detalle-col">
      <section class="caja">
        <h2 class="caja__titulo">Productos</h2>
        <ul class="mini-items mini-items--grande">
          <% p.items.forEach((i) => { %>
            <li>
              <span class="mini-items__foto"><% if (i.imagen) { %><img src="<%= i.imagen %>" alt=""><% } %><b><%= i.cantidad %></b></span>
              <span class="mini-items__datos"><strong><%= i.nombre %></strong><small><%= [i.color || ''].filter(Boolean).join(' · ') %></small></span>
              <span class="mini-items__precio"><%= precio(i.precio * i.cantidad) %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    </div>

    <aside class="detalle-col">
      <section class="caja">
        <h2 class="caja__titulo">Resumen</h2>
        <dl class="totales">
          <div><dt>Subtotal</dt><dd><%= precio(p.subtotal) %></dd></div>
          <% if (p.descuento > 0) { %><div><dt>Descuentos<%= p.cuponCodigo ? ' (' + p.cuponCodigo + ')' : '' %></dt><dd class="resaltado">−<%= precio(p.descuento) %></dd></div><% } %>
          <div class="totales__total"><dt>Total</dt><dd class="precio"><%= precio(p.total) %></dd></div>
        </dl>
        <p class="apagado texto-chico">El pago y la entrega se coordinan por WhatsApp.</p>
      </section>
      <section class="caja">
        <h2 class="caja__titulo"><%= p.entrega === 'retiro' ? 'Retiro en el local' : 'Envío a domicilio' %></h2>
        <% if (p.entrega === 'retiro') { %>
          <p><%= tienda.direccion %></p><% if (tienda.horarios) { %><p class="apagado"><%= tienda.horarios %></p><% } %>
        <% } else { %>
          <p class="apagado">El envío y la dirección se arreglan por WhatsApp.</p>
        <% } %>
        <p class="apagado separado-arriba"><%= p.cliente %> · <%= p.telefono %></p>
      </section>
      <p class="aviso">Guardá el número <strong>#<%= p.numero %></strong> por si querés consultarnos por tu pedido.</p>
    </aside>
  </div>
</section>
<%- include('partials/footer') %>
<script src="/js/mi-pedido.js"></script>
</body>
</html>

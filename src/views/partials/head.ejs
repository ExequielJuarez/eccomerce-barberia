<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= titulo %> | La Vecindad</title>
  <meta name="description" content="<%= locals.descripcion || 'La Vecindad: insumos de peluquería y barbería. Clippers, trimmers, shavers, tijeras y combos. Sacá tu turno online. nuestras sucursales.' %>">
  <meta name="theme-color" content="#0b0b0b">
  <meta name="color-scheme" content="dark">
  <meta property="og:title" content="<%= titulo %> | La Vecindad">
  <meta property="og:type" content="website">
  <meta property="og:image" content="/img/marca/logo.jpg">
  <link rel="icon" href="/img/marca/logo.jpg" type="image/png">
  <link rel="apple-touch-icon" href="/img/marca/logo.jpg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700;800&family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="/js/vista.js" defer></script>
  <link rel="stylesheet" href="/css/base.css">
  <% [].concat(locals.estilo || []).forEach(hoja => { %>
    <link rel="stylesheet" href="/css/<%= hoja %>.css">
  <% }) %>
</head>
<body>

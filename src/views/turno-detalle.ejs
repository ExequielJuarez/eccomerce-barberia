<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const estados = {
    reservado: ['Reservado', 'estado--curso'],
    confirmado: ['Confirmado', 'estado--ok'],
    completado: ['Completado', 'estado--ok'],
    cancelado: ['Cancelado', 'estado--cancelado'],
    ausente: ['No asististe', 'estado--alerta'],
  };
  const [textoEstado, claseEstado] = estados[turno.estado];
  const nombre = turno.cliente.split(' ')[0];
  const titulos = {
    reservado: ['Turno reservado', '¡Listo, ' + nombre + '!', 'Guardá el código o este link: lo necesitás para consultar o cancelar tu turno. Te avisamos acá apenas lo confirmemos.'],
    confirmado: ['Turno confirmado', '¡Confirmado, ' + nombre + '!', 'Te esperamos. Si no podés venir, cancelalo desde acá para liberar el horario.'],
    completado: ['Turno completado', '¡Gracias, ' + nombre + '!', 'Esperamos que hayas quedado conforme. ¡Hasta la próxima!'],
    cancelado: ['Turno cancelado', 'Cancelado', 'Este turno ya no está activo.'],
    ausente: ['Turno sin asistencia', 'No te vimos, ' + nombre, 'Registramos que no asististe. Podés sacar otro turno cuando quieras.'],
  };
  const [etiqueta, titular, bajada] = titulos[turno.estado];
%>

<section class="turnos contenedor turno-detalle" data-turno-codigo="<%= turno.codigo %>">
  <div data-turno-vivo>
  <header class="turnos__cab">
    <p class="etiqueta-seccion"><%= etiqueta %></p>
    <h1 class="pagina__titulo titulo"><%= titular %></h1>
    <p class="pagina__sub"><%= bajada %></p>
  </header>

  <div class="ticket">
    <div class="ticket__cab">
      <span class="estado <%= claseEstado %>"><%= textoEstado %></span>
      <button type="button" class="ticket__codigo" id="copiarCodigo" data-codigo="<%= turno.codigo %>" aria-label="Copiar código <%= turno.codigo %>">
        <small>Código</small><strong><%= turno.codigo %></strong>
      </button>
    </div>
    <dl class="ticket__datos">
      <div><dt>Día</dt><dd><%= turno.fechaTexto %></dd></div>
      <div><dt>Hora</dt><dd><%= turno.inicio %> hs</dd></div>
      <div><dt>Servicio</dt><dd><%= turno.servicio %></dd></div>
      <div><dt>Profesional</dt><dd><%= turno.barbero %></dd></div>
      <div><dt>A nombre de</dt><dd><%= turno.cliente %></dd></div>
      <div><dt>Dónde</dt><dd><%= tienda.direccion %></dd></div>
    </dl>
    <div class="ticket__acciones">
      <% if (whatsapp) { %><a href="<%= whatsapp %>" target="_blank" rel="noopener" class="btn btn--volt">Avisar por WhatsApp</a><% } %>
      <a href="/turnos" class="btn btn--linea">Sacar otro turno</a>
      <% if (puedeCancelar) { %>
        <form action="/turnos/<%= turno.codigo %>/cancelar" method="POST" data-confirmar="¿Querés cancelar este turno?"><button type="submit" class="btn btn--peligro">Cancelar turno</button></form>
      <% } %>
    </div>
  </div>
  </div>
</section>

<%- include('partials/footer') %>
<script src="/js/turnos.js"></script>
</body>
</html>

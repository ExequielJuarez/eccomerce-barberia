<%- include('partials/head') %>
<%- include('partials/header') %>
<% const e = errores; const v = (k) => datos[k] ?? ''; const hayErrores = Object.keys(e).length > 0; %>

<section class="contenedor pagina checkout">
  <%- include('partials/pasos', { paso: 2 }) %>
  <h1 class="pagina__titulo titulo">Tus datos</h1>

  <div class="checkout__grilla">
    <form action="/checkout/datos" method="POST" class="checkout__form" id="formDatos" novalidate>
      <% if (hayErrores) { %><div class="aviso aviso--error" role="alert">Revisá los campos marcados para poder seguir.</div><% } %>

      <fieldset class="bloque-form">
        <legend><span>1</span> Contacto</legend>
        <p class="apagado">Tu pedido se manda por WhatsApp al local con todo el carrito.</p>
        <div class="grilla-form">
          <%- include('partials/campo', { nombre: 'nombre', etiqueta: 'Nombre', valor: v('nombre'), errores: e, atributos: 'autocomplete="given-name" maxlength="40" required' }) %>
          <%- include('partials/campo', { nombre: 'apellido', etiqueta: 'Apellido', valor: v('apellido'), errores: e, atributos: 'autocomplete="family-name" maxlength="40" required' }) %>
          <%- include('partials/campo', { nombre: 'telefono', etiqueta: 'WhatsApp', tipo: 'tel', valor: v('telefono'), errores: e, atributos: 'autocomplete="tel" maxlength="20" placeholder="Con código de área. Ej: 385 4000000" required', clase: 'completo' }) %>
        </div>
      </fieldset>

      <fieldset class="bloque-form">
        <legend><span>2</span> ¿Cómo lo recibís?</legend>
        <div class="opciones-entrega">
          <label class="opcion"><input type="radio" name="entrega" value="retiro" <%= v('entrega') !== 'domicilio' ? 'checked' : '' %>><span><strong>Retiro en el local</strong><small><%= tienda.direccion %><%= tienda.horarios ? " · " + tienda.horarios : "" %></small></span></label>
          <label class="opcion"><input type="radio" name="entrega" value="domicilio" <%= v('entrega') === 'domicilio' ? 'checked' : '' %>><span><strong>Envío a domicilio</strong><small>Se arregla por WhatsApp</small></span></label>
        </div>
        <% if (e.entrega) { %><span class="campo__error"><%= e.entrega.msg %></span><% } %>
      </fieldset>

      <div class="checkout__acciones">
        <a href="/carrito" class="btn btn--linea">Volver</a>
        <button type="submit" class="btn btn--whatsapp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 00-8.5 14.95L2 22l5.2-1.5A9.95 9.95 0 1012.04 2zm0 18.1c-1.5 0-2.97-.4-4.25-1.16l-.3-.18-3.08.9.92-3-.2-.31A8.1 8.1 0 1112.04 20.1zm4.4-6.05c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.1.16 1.52.1.46-.07 1.43-.58 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28z"/></svg> Enviar pedido por WhatsApp</button>
      </div>
    </form>

    <%- include('partials/resumen-pedido', { resumen }) %>
  </div>
</section>

<%- include('partials/footer') %>
<script src="/js/checkout-datos.js"></script>
</body>
</html>
